                "name": "x-fabric-channel-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "orderDraftId",
                "value": "",
                "type": "path",
                "description": "The order draft ID created with [Create an order draft](/v3/cart-and-checkout/api-reference/carts-v3/order-drafts/create-order-drafts) endpoint is used to retrieve the order draft."
              }
            ]
          },
          "docs": "Retrieves the order draft using the order ID associated with it from [Create an order draft](/v3/cart-and-checkout/api-reference/carts-v3/order-drafts/create-order-drafts) endpoint."
