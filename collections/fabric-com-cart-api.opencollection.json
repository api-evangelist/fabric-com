                "name": "x-fabric-channel-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cartId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves the cart information corresponding to the provided cart ID.\n\nThe Cart ID from the [Create cart](/v3/cart-and-checkout/api-reference/carts-v3/carts/carts) endpoint is used in the path parameter.\n"
        },
