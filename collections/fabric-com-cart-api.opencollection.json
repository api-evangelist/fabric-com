            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the cart information corresponding to the provided cart ID.\n\nThe Cart ID from the [Create cart](/v3/cart-and-checkout/api-reference/carts-v3/carts/carts) endpoint is used in the path parameter.\n"
        },
        {
          "info": {
            "name": "Delete Cart",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.fabric.inc/v3/carts/:cartId",
