{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cart Actions Endpoints Global Components API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Global Components",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Live Global Components for a Channel",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fabric.inc/v3/v2/global-component/live",
            "params": [
              {
                "name": "channels",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of channel IDs"
              }
            ]
          },
          "docs": "Gets a list of all the live global component data for a specified channel"
        }
      ]
    }
  ],
  "bundled": true
}