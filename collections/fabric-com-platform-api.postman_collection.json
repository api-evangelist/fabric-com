            "description": {
              "content": "Generates an access token using the client credentials flow. Tokens expire every 60 minutes.\n\nTo authenticate, provide your `client_id`, `client_secret`, and set `grant_type` to `client_credentials`.\n\nIf you do not have a `client_id` and `client_secret`, contact fabric support to request API access credentials.\n",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "platform",
                "v1",
                "auth",
                "token"
              ],
              "host": [
                "commerceos",
                "aiagents",
                "fabric",
                "inc"
              ],
              "query": [],
              "variable": []
            },
