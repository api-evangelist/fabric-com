{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cart Actions Endpoints OrderDrafts API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "OrderDrafts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
