            "headers": [
              {
                "name": "x-fabric-tenant-id",
                "value": ""
              },
              {
                "name": "x-fabric-request-id",
                "value": ""
              },
              {
                "name": "x-fabric-channel-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cartId",
                "value": "",
                "type": "path",
                "description": "The 24-character system-generated Cart ID. This ID is generated using the [Create cart](/v3/api-reference/carts-v3/carts/carts) endpoint."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates an order from the current cart.\n\nThe Cart ID from the [Create cart](/v3/api-reference/carts-v3/carts/carts) endpoint is used in the path parameter.\n"
        }
      ]
    }
  ],
  "bundled": true
