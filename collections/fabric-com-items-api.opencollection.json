                "name": "x-fabric-request-id",
                "value": ""
              },
              {
                "name": "x-fabric-channel-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cartId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates the item in the cart.\n\nThe Cart ID from the [Create cart](/v3/cart-and-checkout/api-reference/carts-v3/carts/carts) endpoint is used in the path parameter.\n"
        },
        {
          "info": {
            "name": "Get Item",
