{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cart Actions Endpoints Cart Adjustments API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cart Adjustments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Adjustment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fabric.inc/v3/carts/:cartId/adjustments",
            "headers": [
              {
                "name": "x-fabric-tenant-id",
                "value": ""
              },
              {
                "name": "x-fabric-request-id",
                "value": ""
              },
              {
                "name": "x-fabric-channel-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cartId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates adjustments to the corresponding cart. This is useful when a price needs to be adjusted by a CSR agent.\n\nThe Cart ID from the [Create cart](/v3/cart-and-checkout/api-reference/carts-v3/carts/carts) endpoint is used in the path parameter.\n"
        },
        {
          "info": {
            "name": "Update Adjustment",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.fabric.inc/v3/carts/:cartId/adjustments/:adjustmentId",
            "headers": [
              {
                "name": "x-fabric-tenant-id",
                "value": ""
              },
              {
                "name": "x-fabric-request-id",
                "value": ""
              },
              {
                "name": "x-fabric-channel-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cartId",
                "value": "",
                "type": "path"
              },
              {
                "name": "adjustmentId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the adjustments made to the corresponding cart.\n\nThe Cart ID from the [Create cart](/v3/cart-and-checkout/api-reference/carts-v3/carts/carts) endpoint is used in the path parameter.\n\nThe Adjustment ID from the [Create adjustment](/v3/cart-and-checkout/api-reference/carts-v3/carts-adjustments/create-adjustments) endpoint is used in the path parameter.\n"
        },
        {
          "info": {
            "name": "Remove Adjustment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.fabric.inc/v3/carts/:cartId/adjustments/:adjustmentId",
            "headers": [
              {
                "name": "x-fabric-tenant-id",
                "value": ""
              },
              {
                "name": "x-fabric-request-id",
                "value": ""
              },
              {
                "name": "x-fabric-channel-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cartId",
                "value": "",
                "type": "path"
              },
              {
                "name": "adjustmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Removes an adjustment made to the corresponding cart.\n\nThe Cart ID from the [Create cart](/v3/cart-and-checkout/api-reference/carts-v3/carts/carts) endpoint is used in the path parameter.\n\nThe Adjustment ID from the [Create adjustment](/v3/cart-and-checkout/api-reference/carts-v3/carts-adjustments/create-adjustments) endpoint is used in the path parameter.\n"
        }
      ]
    }
  ],
  "bundled": true
}