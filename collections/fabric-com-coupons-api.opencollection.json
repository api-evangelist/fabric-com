{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cart Actions Endpoints Coupons API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Coupons",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add Coupon",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fabric.inc/v3/carts/:cartId/coupons/:couponId",
            "headers": [
              {
                "name": "x-fabric-tenant-id",
                "value": ""
              },
              {
                "name": "x-fabric-request-id",
                "value": ""
              },
              {
                "name": "x-fabric-channel-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cartId",
                "value": "",
                "type": "path"
              },
              {
                "name": "couponId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Adds a coupon to the corresponding cart.\n\nThe Cart ID from the [Create cart](/v3/cart-and-checkout/api-reference/carts-v3/carts/carts) endpoint is used in the path parameter.\n\nThe Coupon ID, which is the coupon code generated when [creating a custom coupon](/v3/cart-and-checkout/api-reference/carts-v3/carts-adjustments/create-adjustments) in Copilot, is used in the path parameter.\n"
        },
        {
          "info": {
            "name": "Removes Coupon",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.fabric.inc/v3/carts/:cartId/coupons/:couponId",
            "headers": [
              {
                "name": "x-fabric-tenant-id",
                "value": ""
              },
              {
                "name": "x-fabric-request-id",
                "value": ""
              },
              {
                "name": "x-fabric-channel-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cartId",
                "value": "",
                "type": "path"
              },
              {
                "name": "couponId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Removes the existing coupon from the cart.\n\nThe Cart ID from the [Create cart](/v3/cart-and-checkout/api-reference/carts-v3/carts/carts) endpoint is used in the path parameter.\n\nThe Coupon ID is a coupon code generated when [creating a custom coupon](/v3/cart-and-checkout/api-reference/carts-v3/carts-adjustments/create-adjustments) in Copilot and is used in the path parameter.\n"
        }
      ]
    }
  ],
  "bundled": true
}